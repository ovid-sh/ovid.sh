package md

import ovid/io
import ovid/mem
import text

// Inline renders n bytes of inline Markdown at p into b: as HTML, or, when
// html is false, as the plain text a reader sees. It returns -1, or the
// offset of a ` or ** that is never closed.
func Inline(io *ovid/io.Cap, b *ovid/mem.Buf, p i64, n i64, html bool) i64 {
  var i i64 = 0
  var bad i64 = -1
  while i < n && bad < 0 {
    var c i64 = load8(p + i)
    var c2 i64 = 0
    if (i + 1) < n {
      c2 = load8((p + i) + 1)
    }
    if c == text.BQ {
      var j i64 = text.Find(p, n, i + 1, text.BQ)
      if j < 0 {
        bad = i
      } else {
        if html {
          text.S(io, b, strptr("<code>"))
        }
        Code(io, b, (p + i) + 1, (j - i) - 1, html)
        if html {
          text.S(io, b, strptr("</code>"))
        }
        i = j + 1
      }
    } else if c == text.STAR && c2 == text.STAR {
      var k i64 = bold(p, n, i + 2)
      if k < 0 {
        bad = i
      } else {
        if html {
          text.S(io, b, strptr("<strong>"))
        }
        var r i64 = Inline(io, b, (p + i) + 2, (k - i) - 2, html)
        if r >= 0 {
          bad = (i + 2) + r
        }
        if html {
          text.S(io, b, strptr("</strong>"))
        }
        i = k + 2
      }
    } else if c == text.LBR && link(p, n, i) > 0 {
      var close i64 = text.Find(p, n, i + 1, text.RBR)
      var stop i64 = link(p, n, i)
      if html {
        text.S(io, b, strptr("<a href=\""))
        text.Html(io, b, (p + close) + 2, (stop - close) - 2)
        text.S(io, b, strptr("\">"))
      }
      var r2 i64 = Inline(io, b, (p + i) + 1, (close - i) - 1, html)
      if r2 >= 0 {
        bad = (i + 1) + r2
      }
      if html {
        text.S(io, b, strptr("</a>"))
      }
      i = stop + 1
    } else if c == text.BSL && c2 == text.PIPE {
      ovid/mem.WByte(io, b, text.PIPE)
      i = i + 2
    } else {
      char(io, b, c, html)
      i = i + 1
    }
  }
  return bad
}

// bold is the offset of the ** closing one opened before i, or -1.
func bold(p i64, n i64, i i64) i64 {
  while (i + 1) < n {
    if load8(p + i) == text.STAR && load8((p + i) + 1) == text.STAR {
      return i
    }
    i = i + 1
  }
  return -1
}

// link is the offset of the ) ending a [text](url) that starts at i, or
// -1 when the [ starts no link.
func link(p i64, n i64, i i64) i64 {
  var close i64 = text.Find(p, n, i + 1, text.RBR)
  if close < 0 || (close + 1) >= n || load8((p + close) + 1) != text.LPAR {
    return -1
  }
  return text.Find(p, n, close + 2, text.RPAR)
}

func char(io *ovid/io.Cap, b *ovid/mem.Buf, c i64, html bool) i64 {
  if html {
    return text.Esc(io, b, c)
  }
  return ovid/mem.WByte(io, b, c)
}

// Code writes the n bytes of a code span at p, a \| as |.
func Code(io *ovid/io.Cap, b *ovid/mem.Buf, p i64, n i64, html bool) i64 {
  var i i64 = 0
  while i < n {
    var c i64 = load8(p + i)
    if c == text.BSL && (i + 1) < n && load8((p + i) + 1) == text.PIPE {
      c = text.PIPE
      i = i + 1
    }
    char(io, b, c, html)
    i = i + 1
  }
  return 0
}
