package md

import ovid/io
import ovid/mem
import text

// Highlight writes n bytes of code at p, in the language named by the
// langn bytes at lang, as HTML with <span class> marks: console (a shell
// transcript of ovid commands), jsonl or json, ov; anything else is
// escaped only.
func Highlight(io *ovid/io.Cap, b *ovid/mem.Buf, lang i64, langn i64, p i64, n i64) i64 {
  var kind i64 = 0
  if text.Is(lang, langn, strptr("console"), 7) {
    kind = 1
  } else if text.Is(lang, langn, strptr("jsonl"), 5) || text.Is(lang, langn, strptr("json"), 4) {
    kind = 2
  } else if text.Is(lang, langn, strptr("ov"), 2) {
    kind = 3
  }
  var i i64 = 0
  while i < n {
    var e i64 = text.LineEnd(p, n, i)
    if kind == 1 {
      Console(io, b, p + i, e - i)
    } else if kind == 2 && load8(p + i) == text.LBRACE {
      Json(io, b, p + i, e - i)
    } else if kind == 3 {
      Ov(io, b, p + i, e - i)
    } else {
      text.Html(io, b, p + i, e - i)
    }
    if e < n {
      ovid/mem.WByte(io, b, text.NL)
    }
    i = e + 1
  }
  return 0
}

// mark writes the n bytes at p inside <span class="cls">.
func mark(io *ovid/io.Cap, b *ovid/mem.Buf, cls i64, p i64, n i64) i64 {
  text.S(io, b, strptr("<span class=\""))
  text.S(io, b, cls)
  text.S(io, b, strptr("\">"))
  text.Html(io, b, p, n)
  return text.S(io, b, strptr("</span>"))
}

// Console writes one line of a transcript: "$ " starts a command, "# " a
// comment, "exit N" an exit code, { a JSON record; other lines are output,
// marked as Ovid source.
func Console(io *ovid/io.Cap, b *ovid/mem.Buf, p i64, n i64) i64 {
  if text.Prefix(p, n, strptr("$ "), 2) {
    mark(io, b, strptr("pr"), p, 1)
    ovid/mem.WByte(io, b, text.SP)
    return mark(io, b, strptr("cmd"), p + 2, n - 2)
  }
  if text.Prefix(p, n, strptr("# "), 2) {
    return mark(io, b, strptr("cm"), p, n)
  }
  if text.Prefix(p, n, strptr("exit "), 5) {
    return mark(io, b, strptr("bad"), p, n)
  }
  if n > 0 && load8(p) == text.LBRACE {
    return Json(io, b, p, n)
  }
  return Ov(io, b, p, n)
}

// strEnd is the offset just past the JSON or Ovid string literal that
// opens at i, or n.
func strEnd(p i64, n i64, i i64) i64 {
  var j i64 = i + 1
  var more bool = j < n
  while more {
    var c i64 = load8(p + j)
    if c == text.BSL {
      j = j + 2
    } else {
      j = j + 1
    }
    more = j < n && c != text.DQ
  }
  if j > n {
    return n
  }
  return j
}

// Json writes one line of JSON: keys, strings, numbers, and literals
// marked; "ok":true and "ok":false marked ok and bad.
func Json(io *ovid/io.Cap, b *ovid/mem.Buf, p i64, n i64) i64 {
  var i i64 = 0
  var okkey bool = false
  while i < n {
    var c i64 = load8(p + i)
    var j i64 = i + 1
    if c == text.DQ {
      j = strEnd(p, n, i)
      var k i64 = j
      while k < n && load8(p + k) == text.SP {
        k = k + 1
      }
      if k < n && load8(p + k) == text.COLON {
        okkey = text.Is(p + i, j - i, strptr("\"ok\""), 4)
        mark(io, b, strptr("k"), p + i, j - i)
      } else {
        okkey = false
        mark(io, b, strptr("s"), p + i, j - i)
      }
    } else if text.Digit(c) || c == text.DASH {
      while j < n && (text.Digit(load8(p + j)) || load8(p + j) == text.DOT) {
        j = j + 1
      }
      okkey = false
      mark(io, b, strptr("n"), p + i, j - i)
    } else if text.Alpha(c) {
      while j < n && text.Alpha(load8(p + j)) {
        j = j + 1
      }
      var cls i64 = strptr("n")
      if okkey && c == 116 {
        cls = strptr("ok")
      } else if okkey {
        cls = strptr("bad")
      }
      okkey = false
      mark(io, b, cls, p + i, j - i)
    } else {
      text.Esc(io, b, c)
    }
    i = j
  }
  return 0
}

// Ov writes one line of Ovid source: keywords, types, builtins, numbers,
// strings, and comments marked.
func Ov(io *ovid/io.Cap, b *ovid/mem.Buf, p i64, n i64) i64 {
  var i i64 = 0
  while i < n {
    var c i64 = load8(p + i)
    var j i64 = i + 1
    if c == text.SLASH && j < n && load8(p + j) == text.SLASH {
      j = n
      mark(io, b, strptr("cm"), p + i, j - i)
    } else if c == text.DQ {
      j = strEnd(p, n, i)
      mark(io, b, strptr("s"), p + i, j - i)
    } else if text.Digit(c) {
      while j < n && (text.Digit(load8(p + j)) || text.Alpha(load8(p + j))) {
        j = j + 1
      }
      mark(io, b, strptr("n"), p + i, j - i)
    } else if text.Alpha(c) {
      while j < n && (text.Digit(load8(p + j)) || text.Alpha(load8(p + j))) {
        j = j + 1
      }
      var cls i64 = word(p + i, j - i)
      if cls != 0 {
        mark(io, b, cls, p + i, j - i)
      } else {
        ovid/mem.WBytes(io, b, p + i, j - i)
      }
    } else {
      text.Esc(io, b, c)
    }
    i = j
  }
  return 0
}

// word is the class of an Ovid word of n bytes at p, or 0 for a name.
func word(p i64, n i64) i64 {
  if text.Is(p, n, strptr("package"), 7) || text.Is(p, n, strptr("import"), 6) || text.Is(p, n, strptr("func"), 4) || text.Is(p, n, strptr("var"), 3) || text.Is(p, n, strptr("const"), 5) || text.Is(p, n, strptr("type"), 4) || text.Is(p, n, strptr("struct"), 6) || text.Is(p, n, strptr("if"), 2) || text.Is(p, n, strptr("else"), 4) || text.Is(p, n, strptr("while"), 5) || text.Is(p, n, strptr("return"), 6) || text.Is(p, n, strptr("as"), 2) {
    return strptr("kw")
  }
  if text.Is(p, n, strptr("i64"), 3) || text.Is(p, n, strptr("bool"), 4) {
    return strptr("ty")
  }
  if text.Is(p, n, strptr("true"), 4) || text.Is(p, n, strptr("false"), 5) {
    return strptr("n")
  }
  if text.Is(p, n, strptr("strptr"), 6) || text.Is(p, n, strptr("strlen"), 6) || text.Is(p, n, strptr("sizeof"), 6) || text.Is(p, n, strptr("syscall"), 7) || text.Is(p, n, strptr("load8"), 5) || text.Is(p, n, strptr("load32"), 6) || text.Is(p, n, strptr("load64"), 6) || text.Is(p, n, strptr("store8"), 6) || text.Is(p, n, strptr("store64"), 7) {
    return strptr("bi")
  }
  return 0
}
